<?xml version="1.0" encoding="utf-8"?>
<!--
  The cold-launch splash (Android 12+).

  This is the honest version of the spec's "cold-launch splash": the platform draws the product mark
  on the app's own ground before the process is ready and hands over the instant the first frame is.
  It lasts exactly as long as the app takes to start and not a millisecond more — which is why it is
  configured here rather than built as a Compose screen with a timer, the shape that would let a fast
  launch be padded out to look ceremonial.

  It lives in `:app` rather than beside Theme.LocalKeep.Base in `:core:ui` because it references the
  launcher drawable, which is this module's identity and not the design system's.

  Note this is *not* the Argon2id wait: that happens after unlock is submitted, and is deliberately
  unpadded and shows no fabricated percentage (see DerivingOverlay).
-->
<resources>
    <style name="Theme.LocalKeep" parent="Theme.LocalKeep.Base">
        <item name="android:windowSplashScreenBackground">@color/lk_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lk_dialog</item>
    </style>
</resources>
