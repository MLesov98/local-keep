    <string name="autofill_save_confirm_card_title_fallback">Karte</string>
    <string name="autofill_save_confirm_toast_expired">Dieser Speichervorgang ist abgelaufen — öffnen Sie LocalKeep, um ihn hinzuzufügen</string>
    <string name="autofill_save_confirm_toast_card_no_room">Karte nicht gespeichert — in einem kostenlosen Tresor ist kein Platz für eine weitere Karte. Öffnen Sie LocalKeep, um Platz zu schaffen.</string>

