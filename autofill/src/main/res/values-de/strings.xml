    <string name="autofill_save_confirm_password_title_queued">Auf %2$s erfasste Zugangsdaten für %1$s speichern?</string>
    <string name="autofill_save_confirm_password_title_no_username">Passwort für %1$s speichern?</string>
    <string name="autofill_save_confirm_password_title_update_no_username">Gespeichertes Passwort für %1$s aktualisieren?</string>
    <!-- SECURITY-COPY: tier C — shown only while the vault is locked; explains why an unlock
         prompt is about to follow this confirmation. -->
    <string name="autofill_save_confirm_locked_notice">LocalKeep ist gesperrt — Sie geben als Nächstes Ihr Master-Passwort ein.</string>
    <string name="autofill_save_confirm_update">Aktualisieren</string>
    <string name="autofill_save_confirm_save">Speichern</string>
    <string name="autofill_save_confirm_discard">Verwerfen</string>
    <string name="autofill_save_confirm_summary_target">App oder Website</string>
    <string name="autofill_save_confirm_summary_username">Benutzername</string>
    <string name="autofill_save_confirm_summary_card">Karte</string>
    <string name="autofill_save_confirm_summary_password">Passwort</string>
    <string name="autofill_save_confirm_summary_queued">Erfasst, während LocalKeep gesperrt war</string>
    <!-- SECURITY-COPY: tier C — the unlock detour launched from this screen; explains why
         storing the captured login needs the master password first. -->
    <string name="autofill_save_confirm_unlock_subtitle">Ihr Tresor ist gesperrt. Entsperren Sie ihn, um diese Zugangsdaten zu speichern.</string>
    <string name="autofill_save_confirm_toast_saved">Gespeichert</string>
    <string name="autofill_save_confirm_toast_failed">Konnte nicht speichern</string>
    <!-- Fallback vault-item title for a captured card when neither a web domain nor a package
