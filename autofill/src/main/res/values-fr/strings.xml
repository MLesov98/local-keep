<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Shared by every gate that opens the vault from inside another app's window: the
         AuthActivity default title, the "Unlock LocalKeep" suggestion row before a fill, and
         the same prompt reached from SaveConfirmActivity when a save needs an unlock first. -->
    <string name="autofill_unlock_title">Déverrouiller LocalKeep</string>
    <string name="autofill_unlock_subtitle">Votre coffre est verrouillé</string>
    <!-- SECURITY-COPY: tier C — the reprompt-gate title; explains why this app is asking for
         the master password again for one specific item. -->
    <string name="autofill_auth_reprompt_title">Confirmer que c\'est vous</string>

    <!-- Every case below is AuthPromptMessage.authPromptMessage naming the real cause instead
         of "Wrong password" — the identical mapping the unlock screen uses, worded for a prompt
         that appears inside another app's window with no vault UI on screen to contradict it.
         See the Kotlin comments in AuthPromptMessage.kt for why each is worded as it is. -->
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_vault_unreadable">Le fichier du coffre n\'a pas pu être lu. Votre mot de passe est probablement correct — ouvrez LocalKeep et essayez de restaurer une sauvegarde.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_vault_newer_version">Ce coffre nécessite une version plus récente de LocalKeep. Ouvrez l\'application pour la mettre à jour.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_interrupted">L\'opération a trop duré et le coffre s\'est verrouillé à nouveau. Réessayez.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_biometric_unavailable">Le déverrouillage biométrique n\'est plus disponible. Votre mot de passe principal fonctionne toujours.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_needs_more_memory">Ce coffre nécessite plus de mémoire que cet appareil n\'en autorise pour une application. Votre mot de passe n\'est pas en cause — ouvrez-le sur un appareil avec plus de mémoire.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_memory_transient">LocalKeep manque de mémoire pour le moment. Votre mot de passe n\'est pas en cause — fermez complètement l\'application et réessayez.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_wrong_password">Mot de passe incorrect</string>
    <!-- SECURITY-COPY: tier C — lockout countdown after too many wrong attempts at this gate,
         same reasoning as unlock_retry_after_seconds. -->
    <plurals name="autofill_auth_throttled">
        <item quantity="one">Trop de tentatives. Réessayez dans %1$d seconde.</item>
        <item quantity="many">Trop de tentatives. Réessayez dans %1$d secondes.</item>
        <item quantity="other">Trop de tentatives. Réessayez dans %1$d secondes.</item>
    </plurals>

    <!-- SECURITY-COPY: tier C — the one-time app/domain trust prompt; this pairing is pinned
         permanently once allowed, so the prompt has to say what it is actually deciding. -->
    <string name="autofill_confirm_domain_message">Autoriser %1$s à remplir les identifiants enregistrés pour %2$s\u00a0?</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_confirm_domain_explanation">N\'autorisez ceci que si vous reconnaissez à la fois l\'application et le site. LocalKeep mémorise cet appariement et ne redemandera plus.</string>
    <string name="autofill_confirm_domain_allow">Autoriser</string>
    <string name="autofill_confirm_domain_deny">Refuser</string>

    <!-- SECURITY-COPY: tier C — subtitle of the suggestion row for a reprompt-gated item;
         explains why picking this row will ask for the master password again. -->
    <string name="autofill_dataset_confirm_to_fill">Confirmer pour remplir</string>
    <!-- Suggestion-row title for the one-time-code dataset: the item\'s title with a "2FA"
         marker appended, so it reads apart from the credentials row for the same login.
         "2FA" is kept in every locale, per the glossary. -->
    <string name="autofill_dataset_totp_row_title">%1$s · 2FA</string>
    <!-- SECURITY-COPY: tier F — the TOTP code expires on this countdown; the user has to act
         before it reaches zero. -->
    <plurals name="autofill_dataset_totp_remaining">
        <item quantity="one">%1$d seconde</item>
        <item quantity="many">%1$d secondes</item>
        <item quantity="other">%1$d secondes</item>
    </plurals>

    <!-- SECURITY-COPY: tier C — same domain-pinning gate as autofill_confirm_domain_message,
         this is the suggestion row that launches it. -->
    <string name="autofill_confirm_app_site_title">Confirmer l\'application et le site</string>

    <!-- Fixed strings, deliberately. These cross into the platform\'s own autofill UI and are
         read by whatever app requested the fill, so they must never carry a cause, a path, or
         a vault detail — see LocalAutofillService.onFillRequest / onSaveRequest. -->
    <string name="autofill_service_fill_failed">LocalKeep n\'a pas pu charger les suggestions.</string>
    <string name="autofill_service_save_failed">LocalKeep n\'a pas pu enregistrer cet identifiant.</string>

    <string name="autofill_password_prompt_continue">Continuer</string>
    <string name="autofill_password_prompt_unlocking">Déverrouillage…</string>
