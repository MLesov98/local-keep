<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- Shared by every gate that opens the vault from inside another app's window: the
         AuthActivity default title, the "Unlock LocalKeep" suggestion row before a fill, and
         the same prompt reached from SaveConfirmActivity when a save needs an unlock first. -->
    <string name="autofill_unlock_title">Desbloquear LocalKeep</string>
    <string name="autofill_unlock_subtitle">Seu cofre está bloqueado</string>
    <!-- SECURITY-COPY: tier C — the reprompt-gate title; explains why this app is asking for
         the master password again for one specific item. -->
    <string name="autofill_auth_reprompt_title">Confirmar que é você</string>

    <!-- Every case below is AuthPromptMessage.authPromptMessage naming the real cause instead
         of "Wrong password" — the identical mapping the unlock screen uses, worded for a prompt
         that appears inside another app's window with no vault UI on screen to contradict it.
         See the Kotlin comments in AuthPromptMessage.kt for why each is worded as it is. -->
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_vault_unreadable">O arquivo do cofre não pôde ser lido. Sua senha provavelmente está certa — abra o LocalKeep e tente restaurar um backup.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_vault_newer_version">Este cofre precisa de uma versão mais nova do LocalKeep. Abra o app para atualizar.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_interrupted">Demorou tanto que o cofre se bloqueou novamente. Tente novamente.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_biometric_unavailable">O desbloqueio biométrico não está mais disponível. Sua senha mestra ainda funciona.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_needs_more_memory">Este cofre precisa de mais memória do que este dispositivo permite a um app. Sua senha não é o problema — abra em um dispositivo com mais memória.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_memory_transient">O LocalKeep está com pouca memória no momento. Sua senha não é o problema — feche o aplicativo completamente e tente novamente.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_auth_error_wrong_password">Senha incorreta</string>
    <!-- SECURITY-COPY: tier C — lockout countdown after too many wrong attempts at this gate,
         same reasoning as unlock_retry_after_seconds. -->
    <plurals name="autofill_auth_throttled">
        <item quantity="one">Muitas tentativas. Tente novamente em %1$d segundo.</item>
        <item quantity="many">Muitas tentativas. Tente novamente em %1$d segundos.</item>
        <item quantity="other">Muitas tentativas. Tente novamente em %1$d segundos.</item>
    </plurals>

    <!-- SECURITY-COPY: tier C — the one-time app/domain trust prompt; this pairing is pinned
         permanently once allowed, so the prompt has to say what it is actually deciding. -->
    <string name="autofill_confirm_domain_message">Permitir que %1$s preencha logins salvos para %2$s?</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="autofill_confirm_domain_explanation">Permita apenas se você reconhecer tanto o app quanto o site. O LocalKeep lembra este pareamento e não perguntará de novo.</string>
    <string name="autofill_confirm_domain_allow">Permitir</string>
    <string name="autofill_confirm_domain_deny">Negar</string>

    <!-- SECURITY-COPY: tier C — subtitle of the suggestion row for a reprompt-gated item;
         explains why picking this row will ask for the master password again. -->
    <string name="autofill_dataset_confirm_to_fill">Confirmar para preencher</string>
    <!-- Suggestion-row title for the one-time-code dataset: the item's title with a "2FA"
         marker appended, so it reads apart from the credentials row for the same login.
         "2FA" is kept in every locale, per the glossary. -->
    <string name="autofill_dataset_totp_row_title">%1$s · 2FA</string>
    <!-- SECURITY-COPY: tier F — the TOTP code expires on this countdown; the user has to act
         before it reaches zero. -->
    <plurals name="autofill_dataset_totp_remaining">
        <item quantity="one">%1$d segundo</item>
        <item quantity="many">%1$d segundos</item>
        <item quantity="other">%1$d segundos</item>
    </plurals>

    <!-- SECURITY-COPY: tier C — same domain-pinning gate as autofill_confirm_domain_message,
         this is the suggestion row that launches it. -->
    <string name="autofill_confirm_app_site_title">Confirmar app e site</string>

    <!-- Fixed strings, deliberately. These cross into the platform's own autofill UI and are
         read by whatever app requested the fill, so they must never carry a cause, a path, or
         a vault detail — see LocalAutofillService.onFillRequest / onSaveRequest. -->
    <string name="autofill_service_fill_failed">O LocalKeep não pôde carregar sugestões.</string>
    <string name="autofill_service_save_failed">O LocalKeep não pôde salvar este login.</string>

    <string name="autofill_password_prompt_continue">Continuar</string>
    <string name="autofill_password_prompt_unlocking">Desbloqueando…</string>
    <string name="autofill_password_prompt_hint">Senha mestra</string>

    <!-- Fallback for the site/app name when neither a web domain nor a package label is
         available, used inside autofill_save_confirm_password_title_*. -->
    <string name="autofill_save_confirm_target_fallback">este app</string>
    <string name="autofill_save_confirm_card_title">Salvar o cartão terminado em %1$s no LocalKeep?</string>
    <string name="autofill_save_confirm_password_title_locked">Salvar a senha para %1$s em %2$s?</string>
    <string name="autofill_save_confirm_password_title_update">Atualizar a senha salva para %1$s em %2$s?</string>
    <string name="autofill_save_confirm_password_title_new">Salvar um novo login para %1$s em %2$s?</string>
    <string name="autofill_save_confirm_password_title_queued">Salvar o login para %1$s capturado em %2$s?</string>
    <string name="autofill_save_confirm_password_title_no_username">Salvar a senha para %1$s?</string>
    <string name="autofill_save_confirm_password_title_update_no_username">Atualizar a senha salva para %1$s?</string>
    <!-- SECURITY-COPY: tier C — shown only while the vault is locked; explains why an unlock
         prompt is about to follow this confirmation. -->
    <string name="autofill_save_confirm_locked_notice">O LocalKeep está bloqueado — você entrará com sua senha mestra a seguir.</string>
    <string name="autofill_save_confirm_update">Atualizar</string>
    <string name="autofill_save_confirm_save">Salvar</string>
    <string name="autofill_save_confirm_discard">Descartar</string>
    <string name="autofill_save_confirm_summary_target">App ou site</string>
    <string name="autofill_save_confirm_summary_username">Nome de usuário</string>
    <string name="autofill_save_confirm_summary_card">Cartão</string>
    <string name="autofill_save_confirm_summary_password">Senha</string>
    <string name="autofill_save_confirm_summary_queued">Capturado enquanto o LocalKeep estava bloqueado</string>
    <!-- SECURITY-COPY: tier C — the unlock detour launched from this screen; explains why
         storing the captured login needs the master password first. -->
    <string name="autofill_save_confirm_unlock_subtitle">Seu cofre está bloqueado. Desbloqueie-o para armazenar este login.</string>
    <string name="autofill_save_confirm_toast_saved">Salvo</string>
    <string name="autofill_save_confirm_toast_failed">Não foi possível salvar</string>
    <!-- Fallback vault-item title for a captured card when neither a web domain nor a package
