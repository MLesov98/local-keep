    <string name="autofill_save_confirm_card_title_fallback">Cartão</string>
    <string name="autofill_save_confirm_toast_expired">Este salvamento expirou — abra o LocalKeep para adicioná-lo</string>
    <string name="autofill_save_confirm_toast_card_no_room">Cartão não salvo — um cofre gratuito não tem espaço para outro cartão. Abra o LocalKeep para liberar espaço.</string>

    <string name="autofill_suggest_generate_title">Usar a senha sugerida</string>
    <string name="autofill_suggest_generate_subtitle">Senha forte do LocalKeep</string>
    <string name="autofill_suggest_search_title">Pesquisar no LocalKeep</string>
    <string name="autofill_suggest_search_subtitle">Escolher um login salvo</string>
    <string name="autofill_generate_heading">Senha sugerida</string>
