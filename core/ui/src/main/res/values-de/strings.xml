    <!-- ProGate.kt -->
    <!-- %1$s is the locked category's own name (e.g. "Cards", "Files & media"), passed by the
         caller — never the name of a single item. -->
    <!-- SECURITY-COPY: tier E. %1$s is PRO_PRICE, deliberately left untranslated per
         the security-copy rules — Play Billing's own localised price is the
         authority on what a user is actually charged. -->
    <string name="core_ui_pro_gate_unlock_prompt">Dies ist Teil von Pro — eine einmalige Freischaltung für %1$s. Einmalige Zahlung, kein Abonnement, und alles, was Sie bereits haben, funktioniert weiter, auch wenn Sie es nie kaufen.</string>
    <!-- SECURITY-COPY: tier E. Shown when Play has not told us the price (and always in
         foss, which sells nothing). States no amount at all rather than a literal. -->
    <string name="core_ui_pro_gate_unlock_prompt_no_price">Dies ist Teil von Pro — eine einmalige Freischaltung. Einmalige Zahlung, kein Abonnement, und alles, was Sie bereits haben, funktioniert weiter, auch wenn Sie es nie kaufen.</string>
    <string name="core_ui_pro_gate_foss_locked_note">Diese Pro-Funktion ist in der Play Store-Version der App verfügbar.</string>
    <!-- "Google Play" is a product name, never translated. -->
    <string name="core_ui_pro_gate_view_on_play">Auf Google Play ansehen</string>
    <!-- "Pro" is the app's fixed tier name, never translated. -->
    <string name="core_ui_pro_gate_heading">Pro-Funktion</string>

    <!-- The two things an unlock attempt has to be able to say. Shared by Settings, the vault list
         and the item editor, which all raise the same purchase from their own screen.
         Names no cause: Play answers a refused launch, an unreachable store and a misconfigured
         product identically, so naming one of them would be a guess told to the user as fact. -->
    <string name="core_ui_pro_gate_purchase_failed">Der Kauf konnte nicht gestartet werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut.</string>
    <!-- Never say "try again" here: Play completes a pending purchase on its own, and a retry
         invites a second charge. -->
    <string name="core_ui_pro_gate_purchase_pending">Dieser Kauf ist noch nicht bestätigt. Pro wird von selbst freigeschaltet, sobald er abgeschlossen ist — Sie müssen ihn nicht erneut kaufen.</string>
    <string name="core_ui_pro_gate_purchase_already_owned">Pro gehört bereits zu einem Google-Konto und kann daher nicht zweimal gekauft werden. Falls es hier nicht freigeschaltet ist, verwenden Sie „Käufe wiederherstellen“ in den Einstellungen und prüfen Sie, mit welchem Konto Play angemeldet ist.</string>

