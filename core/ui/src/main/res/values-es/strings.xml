<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- AlwaysOn.kt: the always-on protection claims shown by Settings' "How this works" group
         and the Security tab's summary list. Sourced from one place so the two screens cannot
         end up making different claims about the same cryptography. -->
    <string name="core_ui_always_on_encryption_title">Cifrado</string>
    <!-- SECURITY-COPY: tier G. Names the algorithms used to protect the vault. -->
    <string name="core_ui_always_on_encryption_summary">Todo está cifrado con su contraseña maestra — Argon2id, luego AES-256-GCM-SIV</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_encryption_detail">Su contraseña maestra se refuerza con Argon2id (calibrado para este dispositivo) y se convierte en una clave de cifrado de claves, que envuelve una clave de datos aleatoria. Los contenidos de la caja fuerte se cifran con AES-256-GCM-SIV. Las claves se borran de la memoria al bloquear. Nada se envía a ningún lugar para hacer nada de esto.</string>

    <string name="core_ui_always_on_throttling_title">Limitación de intentos de desbloqueo</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_throttling_summary">Los intentos se vuelven más lentos y no se pueden desactivar</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_throttling_detail">Las contraseñas maestras incorrectas repetidas se retrasan con una espera creciente, de modo que los intentos a través de la aplicación siguen siendo lentos. Quien tenga el archivo de la caja fuerte elude esto por completo — allí, el costo por intento es Argon2id. La espera siempre está activada y no se puede desactivar.</string>

    <string name="core_ui_always_on_phishing_title">Alertas anti-phishing</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_phishing_summary">El autocompletado pregunta antes de rellenar el sitio incorrecto</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_phishing_detail">Cuando una aplicación o sitio no coincide con el dominio del elemento guardado, LocalKeep pregunta antes de rellenar en lugar de rellenar silenciosamente. Siempre activada: una comprobación que usted pudiera desactivar no protegería a nadie.</string>

    <string name="core_ui_always_on_screenblock_title">Bloqueo de pantalla y selector de aplicaciones</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_screenblock_summary">Las capturas de pantalla y la vista previa de recientes están bloqueadas</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_screenblock_detail">Cada ventana de la aplicación está marcada como segura, por lo que las capturas de pantalla y las grabaciones de pantalla aparecen en blanco, y el selector de aplicaciones no muestra ninguna vista previa de su caja fuerte.</string>

    <!-- The root/tamper fact. Title carries no claim, so it is untagged. -->
    <string name="core_ui_always_on_root_title">Dispositivos rooteados o modificados</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_root_summary">Comprobado al iniciar — un aviso, no una defensa</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_root_detail">LocalKeep busca indicios habituales de que este dispositivo ha sido rooteado o modificado, y le avisa una vez si encuentra alguno. Un inicio silencioso no demuestra nada: son comprobaciones sencillas de archivos y etiquetas de compilación, y el software diseñado para ocultar el root las supera. Por eso el aviso nunca le bloquea: informa de una situación, no protege frente a ella. Quien controle el sistema operativo puede leer esta pantalla y registrar su contraseña maestra mientras la escribe, y ningún gestor de contraseñas de ningún teléfono puede impedirlo.</string>

    <string name="core_ui_always_on_leaves_device_title">Lo que puede salir de este dispositivo</string>
    <!-- SECURITY-COPY: tier G. Claims what does and does not leave the device — see the Tier G
         note on unlock_subtitle in the security-copy protocol for why this class of
         claim needs a native reader, not just a fluent one. -->
    <string name="core_ui_always_on_leaves_device_summary">Una copia de seguridad cifrada, si lo autoriza. Nada más.</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_leaves_device_detail">La copia de seguridad automática de Android puede subir su archivo de caja fuerte a su cuenta de Google, pero solo como texto cifrado — es ilegible sin su contraseña maestra. Para impedirlo, desactive Incluir la caja fuerte en la copia de Android en Copia de seguridad y exportación. Los informes de errores enviados a la Play Store nunca incluyen contenidos de caja fuerte, contraseñas o claves. Algunos fabricantes de teléfonos sincronizan el portapapeles del sistema entre dispositivos — LocalKeep marca los secretos copiados como sensibles y los borra automáticamente, pero por eso mismo importa el borrado automático.</string>

