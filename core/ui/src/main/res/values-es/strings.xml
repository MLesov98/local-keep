    <!-- ProGate.kt -->
    <!-- %1$s is the locked category's own name (e.g. "Cards", "Files & media"), passed by the
         caller — never the name of a single item. -->
    <!-- SECURITY-COPY: tier E. %1$s is PRO_PRICE, deliberately left untranslated per
         the security-copy rules — Play Billing's own localised price is the
         authority on what a user is actually charged. -->
    <string name="core_ui_pro_gate_unlock_prompt">Esto es parte de Pro — un desbloqueo único de %1$s. Un pago, sin suscripción, y todo lo que ya tiene sigue funcionando aunque nunca lo compre.</string>
    <!-- SECURITY-COPY: tier E. Shown when Play has not told us the price (and always in
         foss, which sells nothing). States no amount at all rather than a literal. -->
    <string name="core_ui_pro_gate_unlock_prompt_no_price">Esto es parte de Pro — un desbloqueo único. Un pago, sin suscripción, y todo lo que ya tiene sigue funcionando aunque nunca lo compre.</string>
    <string name="core_ui_pro_gate_foss_locked_note">Esta función de Pro está disponible en la versión de Play Store de la aplicación.</string>
    <!-- "Google Play" is a product name, never translated. -->
    <string name="core_ui_pro_gate_view_on_play">Ver en Google Play</string>
    <!-- "Pro" is the app's fixed tier name, never translated. -->
    <string name="core_ui_pro_gate_heading">Función Pro</string>

    <!-- The two things an unlock attempt has to be able to say. Shared by Settings, the vault list
         and the item editor, which all raise the same purchase from their own screen.
         Names no cause: Play answers a refused launch, an unreachable store and a misconfigured
         product identically, so naming one of them would be a guess told to the user as fact. -->
    <string name="core_ui_pro_gate_purchase_failed">No se pudo iniciar la compra. Revise su conexión e inténtelo de nuevo.</string>
    <!-- Never say "try again" here: Play completes a pending purchase on its own, and a retry
         invites a second charge. -->
    <string name="core_ui_pro_gate_purchase_pending">Esta compra aún no está confirmada. Pro se desbloqueará solo en cuanto se complete; no hace falta comprarlo de nuevo.</string>
    <string name="core_ui_pro_gate_purchase_already_owned">Pro ya está comprado en una cuenta de Google, así que no se puede comprar dos veces. Si no se ha desbloqueado aquí, use Restaurar compras en Ajustes y compruebe con qué cuenta ha iniciado sesión Play.</string>

