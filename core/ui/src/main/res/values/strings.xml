    <!-- ProGate.kt -->
    <!-- %1$s is the locked category's own name (e.g. "Cards", "Files & media"), passed by the
         caller — never the name of a single item. -->
    <!-- %1$s is PRO_PRICE, deliberately left untranslated per
         the security-copy rules — Play Billing's own localised price is the
         authority on what a user is actually charged. -->
    <!-- SECURITY-COPY: tier E -->
    <string name="core_ui_pro_gate_unlock_prompt">This is part of Pro — a one-time %1$s unlock. One payment, no subscription, and everything you already have keeps working even if you never buy it.</string>
    <!-- Shown when Play has not told us the price (and always in
         foss, which sells nothing). States no amount at all rather than a literal. -->
    <!-- SECURITY-COPY: tier E -->
    <string name="core_ui_pro_gate_unlock_prompt_no_price">This is part of Pro — a one-time unlock. One payment, no subscription, and everything you already have keeps working even if you never buy it.</string>
    <string name="core_ui_pro_gate_foss_locked_note">This Pro feature is in the Play Store version of the app.</string>
    <!-- "Google Play" is a product name, never translated. -->
    <string name="core_ui_pro_gate_view_on_play">View on Google Play</string>
    <!-- "Pro" is the app's fixed tier name, never translated. -->
    <string name="core_ui_pro_gate_heading">Pro feature</string>

    <!-- The two things an unlock attempt has to be able to say. Shared by Settings, the vault list
         and the item editor, which all raise the same purchase from their own screen.
         Names no cause: Play answers a refused launch, an unreachable store and a misconfigured
         product identically, so naming one of them would be a guess told to the user as fact. -->
    <string name="core_ui_pro_gate_purchase_failed">The purchase could not be started. Check your connection and try again.</string>
    <!-- Never say "try again" here: Play completes a pending purchase on its own, and a retry
         invites a second charge. -->
    <string name="core_ui_pro_gate_purchase_pending">This purchase has not been confirmed yet. Pro unlocks by itself as soon as it clears — there is no need to buy it again.</string>
    <!-- Play answered ITEM_ALREADY_OWNED and re-querying still did not unlock Pro here. Never say
         "try again": Play will not sell a one-time product twice, so the retry this used to offer
         returned the same error forever. Says "a Google account" rather than "this one" on
         purpose — the re-query fails both when a different account owns it and when Play could not
         be reached, and the app cannot tell those apart from here. Names Restore purchases because
         that is the only action that can actually resolve it. -->
    <!-- SECURITY-COPY: tier E -->
    <string name="core_ui_pro_gate_purchase_already_owned">Pro is already owned on a Google account, so it cannot be bought twice. If it has not unlocked here, use Restore purchases in Settings and check which account Play is signed in to.</string>

