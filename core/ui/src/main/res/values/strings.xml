         core_ui_deriving_default_title, but callers may override it). -->
    <string name="core_ui_deriving_announce">%1$s. This takes a few seconds.</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_deriving_rationale">This wait is the point — it is the same cost an attacker pays for every guess. No delay is ever added.</string>

