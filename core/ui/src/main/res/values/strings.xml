<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- AlwaysOn.kt: the always-on protection claims shown by Settings' "How this works" group
         and the Security tab's summary list. Sourced from one place so the two screens cannot
         end up making different claims about the same cryptography. -->
    <string name="core_ui_always_on_encryption_title">Encryption</string>
    <!-- Names the algorithms used to protect the vault. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_encryption_summary">Everything is encrypted with your master password — Argon2id, then AES-256-GCM-SIV</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_encryption_detail">Your master password is stretched with Argon2id (calibrated to this device) into a key-encryption key, which wraps a random data key. Vault contents are encrypted with AES-256-GCM-SIV. Keys are wiped from memory on lock. Nothing is sent anywhere to do any of this.</string>

    <string name="core_ui_always_on_throttling_title">Unlock throttling</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_throttling_summary">Guesses get slower, and cannot be turned off</string>
    <!-- Claimed guessing stayed slow "even with the vault file in hand"
         until 2026-07-30 — the one case where this backoff does nothing, since an attacker with
         vault.enc runs their own cracker. It also contradicted settings_error_password_too_weak.
         Now scoped to the app, and names Argon2id as what actually costs an offline attacker;
         TierGClaimsTest asserts that name stays. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_throttling_detail">Repeated wrong master passwords are delayed with a growing backoff, so guessing through the app stays slow. Someone holding the vault file bypasses this entirely — there, the cost per guess is Argon2id. The backoff is always on and cannot be turned off.</string>

    <string name="core_ui_always_on_phishing_title">Anti-phishing prompts</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_phishing_summary">Autofill asks before filling the wrong site</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_phishing_detail">When an app or site doesn\'t match the saved entry\'s domain, LocalKeep asks before filling instead of filling quietly. It is always on: a check you could switch off would protect nobody.</string>

    <string name="core_ui_always_on_screenblock_title">Screen and app-switcher blocking</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_screenblock_summary">Screenshots and the recents preview are blocked</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_screenblock_detail">Every window in the app is marked secure, so screenshots and screen recordings come out blank and the app-switcher shows no preview of your vault.</string>

    <!-- The root/tamper fact. Title carries no claim, so it is untagged. -->
    <string name="core_ui_always_on_root_title">Rooted and modified devices</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_root_summary">Checked at launch — a warning, not a defense</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_root_detail">LocalKeep looks for common signs that this device has been rooted or modified, and warns you once if it finds any. A quiet launch is no news rather than a clean bill of health: these are simple file and build-tag checks, and software built to hide root will pass them. That is why the warning never blocks you — it reports a condition, it does not defend against one. Someone who controls the operating system can read this screen and record your master password as you type it, and no password manager on any phone can prevent that.</string>

    <string name="core_ui_always_on_leaves_device_title">What can leave this device</string>
    <!-- Claims what does and does not leave the device — see the Tier G
         note on unlock_subtitle in the security-copy protocol for why this class of
         claim needs a native reader, not just a fluent one. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_leaves_device_summary">An encrypted backup, if you allow it. Nothing else.</string>
    <!-- The cloud-backup sentence names the switch as it is drawn and in
         the polarity it operates. It used to read "turn it off under Vault → Cloud backup", which
         was wrong twice: there is no row called "Cloud backup" (the control is a switch labelled
         "Disable cloud backup", in Settings and on the Backup screen), and following the
         instruction literally means turning that switch ON. The one place the app explains what
         may leave the device cannot send the user the wrong way. F13 UX persona, 2026-08-30. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="core_ui_always_on_leaves_device_detail">Android Auto Backup may upload your vault file to your Google account, but only as encrypted ciphertext — it is unreadable without your master password. To stop it, turn off Include vault in Android backup in Backup &amp; export. Crash reports sent to the Play Store never include vault contents, passwords, or keys. Some phone makers sync the system clipboard across devices — LocalKeep marks copied secrets as sensitive and clears them automatically, but that sync is why auto-clear matters.</string>

    <!-- ClipboardCountdown.kt -->
    <!-- %1$s is the clipboard entry's label (e.g. "Password", "TOTP code"), supplied by the copy
         site via ClipboardHelper — not itself defined in this module. -->
    <string name="core_ui_clipboard_copied_label">%1$s copied</string>
    <!-- Clipboard clear countdown; %1$d is the whole seconds remaining. -->
    <!-- SECURITY-COPY: tier F -->
    <plurals name="core_ui_clipboard_clears_in_seconds">
        <item quantity="one">Clipboard clears in %1$ds</item>
        <item quantity="other">Clipboard clears in %1$ds</item>
    </plurals>
    <string name="core_ui_clipboard_clear_now">Clear now</string>
    <!-- Accessibility label for the "Clear now" chip. -->
    <string name="core_ui_clipboard_clear_now_action">Clear the clipboard now</string>

    <!-- PermissionDenial.kt: %1$s is featureSentence, a caller-supplied sentence already ending
         in a period (e.g. "LocalKeep can't scan a QR code without camera access."), so this
         string continues it as a second sentence. -->
    <string name="core_ui_permission_denial_retry">%1$s You can tap it again to allow access.</string>
    <string name="core_ui_permission_denial_settings_required">%1$s Android won\'t ask again, so it has to be granted in Settings.</string>
    <string name="core_ui_permission_denial_open_settings">Open settings</string>

