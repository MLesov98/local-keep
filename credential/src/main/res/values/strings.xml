<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- BiometricPrompt title to unlock LocalKeep from the OS credential picker, and the
         action label the system offers when the vault is locked (BeginGetCredentialResponse
         authenticationActions). Shared between CredentialActivity and
         LocalCredentialProviderService: same wording, same purpose. -->
    <string name="credential_unlock_action_label">Unlock LocalKeep</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_biometric_subtitle">Verify to use a saved credential</string>

    <!-- Freshness re-check before a passkey, or a reprompt-flagged password, is handed to the
         calling app. -->
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_verify_title">Confirm it\'s you</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_verify_passkey_subtitle">Verify to use this passkey</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_verify_password_subtitle">Verify to use this password</string>

    <!-- Shown when an app with no verified web presence asks to create a passkey — the user is
         trusting the app's own claim of which site it represents. -->
    <string name="credential_native_binding_title">Allow this app?</string>
    <!-- %1$s: the calling app's package name. %2$s: the relying-party id it claims. -->
    <string name="credential_native_binding_message">%1$s wants to create a passkey for \"%2$s\". LocalKeep cannot verify this offline app-to-site binding.</string>
    <string name="credential_native_binding_allow">Allow</string>
    <string name="credential_native_binding_cancel">Cancel</string>

    <!-- Account name shown by the system's credential-save picker (CreateEntry). -->
    <string name="credential_provider_account_name" translatable="false">LocalKeep</string>
    <!-- %1$s: the relying-party id (site/app) the passkey is being saved for. -->
    <string name="credential_provider_create_description">Save a passkey for %1$s</string>
    <!-- The label one passkey carries in the system's credential picker: the account name, then
         the day the passkey was made. Several passkeys for one account are otherwise identical
         rows and the platform collapses them into one. %1$s is the account name, %2$s the
         creation date in the reader's own convention. -->
    <string name="credential_passkey_entry_display_name">%1$s · %2$s</string>
    <!-- The in-ceremony master-password unlock (2C-F14). A locked vault used to end a passkey
         request outright on any device where biometric unlock was never enabled; this is the
         same affordance the autofill gate has always had, and the copy is deliberately the
         wording that gate already uses. -->
    <string name="credential_unlock_password_body">Your vault is locked. Enter your master password to continue here.</string>
    <string name="credential_unlock_password_label">Master password</string>
    <string name="credential_unlock_password_submit">Unlock</string>
    <!-- Submit label while VaultLockManager.unlock runs its multi-second Argon2id derivation. -->
    <string name="credential_unlock_password_working">Unlocking…</string>

    <!-- Every case below is credentialUnlockMessage naming the real cause instead of "Wrong
         password" — the identical mapping the unlock screen and the autofill gate use, worded
         for a dialog raised inside another app's window with no vault UI to contradict it. -->
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_vault_unreadable">The vault file couldn\'t be read. Your password is probably fine — open LocalKeep and try restoring a backup.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_vault_newer_version">This vault needs a newer version of LocalKeep. Open the app to update.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_interrupted">That took long enough for the vault to re-lock. Try again.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_biometric_unavailable">Biometric unlock is no longer available. Your master password still works.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_needs_more_memory">This vault needs more memory than this device allows an app. Your password is fine — open it on a device with more memory.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_memory_transient">LocalKeep is short of memory right now. Your password is fine — close the app completely and try again.</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="credential_unlock_error_wrong_password">Wrong password</string>
    <!-- Lockout countdown after too many wrong attempts at this gate. -->
    <!-- SECURITY-COPY: tier C -->
    <plurals name="credential_unlock_throttled">
        <item quantity="one">Too many attempts. Try again in %1$d second.</item>
        <item quantity="other">Too many attempts. Try again in %1$d seconds.</item>
    </plurals>
</resources>
