    <!-- ==================== MediaErrors.kt ====================
         The user-facing text for a failed media operation. None of these carry e.message — see
         the KDoc on MediaErrors for why. -->
    <string name="files_error_corrupted_file">This file is corrupted or was tampered with and cannot be decrypted.</string>
    <string name="files_error_corrupted_video">This video is corrupted or was tampered with and cannot be decrypted.</string>
    <string name="files_error_open_failed">Could not open this file. Its encrypted copy may be missing, or there may not be enough free space to decrypt it.</string>
    <string name="files_error_video_open_failed">Could not open this video. Its encrypted copy may be missing, or this device may not be able to play it.</string>
    <string name="files_error_restore_failed">Could not restore this file to your gallery. There may not be enough free space, or your gallery may have refused the file.</string>
    <string name="files_error_import_failed">Could not import that file. It may be too large, or the app that provided it may no longer have it.</string>
    <string name="files_error_capture_failed">Could not save that photo. There may not be enough free space, or your vault may have locked before it was written.</string>
    <string name="files_error_save_failed">Could not save this file to your vault. Your vault may have locked while you were editing, or there may not be enough free space.</string>
    <string name="files_error_pdf_open_failed">Could not open this PDF. It may be damaged, or it may be password-protected — this viewer cannot open an encrypted PDF. You can still save it to your device and open it in a PDF reader.</string>
    <string name="files_error_text_too_large">This file is too large to show here. Save it to your device to read it.</string>
    <!-- The bytes are intact and decrypted; this device just has no codec for the format. Never
         phrase this as a decryption or corruption failure — that is files_error_corrupted_file. -->
    <string name="files_error_image_undecodable">This image decrypted correctly but isn\'t in a format this device can decode. Export it to your gallery to open it in another app.</string>
    <string name="files_error_image_too_large">This image is too large for this device to open here. Export it to your gallery to open it in another app.</string>
    <!-- Writing to the gallery uses the scoped-storage MediaStore insert, which is Android 10+.
         Below that there is no route that does not ask for a storage permission this app refuses
         to declare, so the honest answer is the OS version and nothing else. -->
    <string name="files_error_export_needs_newer_android">Exporting to your gallery needs Android 10 or later. This device runs an older version.</string>
    <!-- ENOSPC. Separated from the generic messages above because the generic ones name a cause
         that is not this one ("too large", "the app that provided it may no longer have it") and
         invite a retry that fails identically every time. Mirrors itemedit_error_out_of_space,
         which the item editor's save path already distinguishes. -->
    <string name="files_error_out_of_space">This device is out of storage space, so the file could not be stored. Free up space, then try again.</string>

