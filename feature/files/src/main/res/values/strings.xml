    <string name="files_notice_item_saved">Item saved</string>
    <!-- ==================== The original left outside the vault (2026-10-09) ====================
         Asked after Save when a gallery photo or video, or a local document, still has its
         original outside LocalKeep. For a gallery item Android's own "Allow LocalKeep to delete
         this photo?" follows; the app cannot reword that sentence, which is why this question
         comes first. A document has no system dialog and no bin, so for it this is the only
         confirmation, and it says "permanently". -->
    <!-- SECURITY-COPY: tier A -->
    <string name="files_original_prompt_title_gallery">Delete the original from your Gallery?</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="files_original_prompt_title_document">Delete the original file?</string>
    <!-- %1$s is the item's title. "where LocalKeep does not protect it" is a claim about the copy
         outside the vault and nothing more: it must not say the gallery is unsafe, public or
         shared, which the app does not know. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="files_original_prompt_body_photo">“%1$s” is saved and encrypted in LocalKeep.\n\nThe original photo is still in your Gallery, where LocalKeep does not protect it.</string>
    <!-- SECURITY-COPY: tier G -->
    <string name="files_original_prompt_body_video">“%1$s” is saved and encrypted in LocalKeep.\n\nThe original video is still in your Gallery, where LocalKeep does not protect it.</string>
    <!-- The only confirmation a document delete gets: no system dialog follows and there is no
         bin. "permanent" must survive translation; a softened "will be removed" is the defect. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="files_original_prompt_body_document">“%1$s” is saved and encrypted in LocalKeep.\n\nThe original file is still on this device, where LocalKeep does not protect it.\n\nDeleting it is permanent: it does not go to a bin.</string>
    <!-- The ellipsis says one more step follows: Android's own confirmation. -->
    <!-- SECURITY-COPY: tier A -->
    <string name="files_original_prompt_confirm_gallery">Delete from Gallery…</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="files_original_prompt_confirm_document">Delete permanently</string>
    <string name="files_original_prompt_keep">Keep it</string>
    <string name="files_original_prompt_dont_ask">Don\'t ask again</string>
    <string name="files_original_prompt_dont_ask_hint">You can turn this back on in Settings.</string>
    <string name="files_notice_original_deleted_gallery">Deleted from your Gallery</string>
    <string name="files_notice_original_kept_gallery">The original is still in your Gallery</string>
    <string name="files_notice_original_deleted_document">Original file deleted</string>
    <string name="files_notice_original_delete_failed">The original couldn\'t be deleted. It is still on this device.</string>
    <!-- Posted instead of files_notice_item_saved when the folder the user filed the file into was
         deleted from another surface between the pick and the save, so it was filed nowhere. Same
         sentence as itemedit_folder_absent_notice and vaultlist_folder_absent_notice: one outcome,
         one phrasing. -->
    <string name="files_notice_folder_absent">That folder no longer exists. The item was saved without one.</string>
    <!-- The file viewer's Trash confirmation and its Undo — the notice the list and the item
         detail already post for the same action. Same words as itemedit_notice_*. -->
    <string name="files_notice_moved_to_trash">Moved to trash</string>
    <string name="files_notice_undo">Undo</string>
    <string name="files_notice_restored">Restored</string>
    <string name="files_notice_restore_failed">Couldn\'t put it back. It is still in Trash.</string>
    <!-- Attachment size below 1 KB, the one branch of asReadableSize with a word in it.
         KB/MB/GB stay as international symbols; only this needs translating.
         %1$d is the byte count. -->
    <plurals name="files_size_bytes">
        <item quantity="one">%1$d byte</item>
        <item quantity="other">%1$d bytes</item>
    </plurals>
    <!-- Deliberately word-for-word `itemedit_save_sheet_title` / `_confirm`. This sheet and the item
         editor's are the same sheet doing the same job one tap apart, and they read "Name and save
         it" / "Save file" against "Name it" / "Save item" — one concept with two presentations,
         reachable within the same minute. Duplicated rather than shared because :feature:files and
         :feature:itemedit have no common resource module. -->
    <string name="files_edit_naming_title">Name it</string>
    <string name="files_edit_naming_subtitle">The name is what search and the vault list have to go on.</string>
    <string name="files_edit_naming_confirm">Save item</string>
    <string name="files_error_folder_name_exists">A folder with that name already exists</string>
    <string name="files_error_folder_action_failed">That didn\'t go through. Your changes are still here — try again.</string>
    <string name="files_folder_picker_subfolder">%1$s, inside %2$s</string>
    <string name="files_folder_name_suffix" translatable="false">%1$s (%2$d)</string>
    <string name="files_viewer_trash">Trash</string>
    <string name="files_error_delete_failed">That didn\'t go through. The file is still here — try again.</string>
    <!-- What the secure viewer's header calls the kind of thing it is showing. One word each:
         they appear as a title and, truncated to three characters, as a fallback badge. -->
    <string name="files_kind_image">Image</string>
    <string name="files_kind_playable">Media</string>
    <string name="files_kind_pdf">PDF</string>
    <string name="files_kind_text">Text</string>
    <string name="files_kind_office">Document</string>
    <string name="files_kind_other">File</string>
    <!-- Filmstrip type badges, used only when a stored filename carries no extension to show.
         Format tokens rather than words, and untranslated for the reason the do-not-translate list gives
         for MIME types and file extensions. The badge used to be the first three characters of the
         kind's screen title, which rendered "Text" as "Tex" beside another .txt file's honest "TXT"
         (release sweep 2026-09-20, finding 4C.2-txt) and would have cut every localised word too. -->
    <string name="files_badge_image" translatable="false">IMG</string>
    <string name="files_badge_playable" translatable="false">MEDIA</string>
    <string name="files_badge_pdf" translatable="false">PDF</string>
    <string name="files_badge_text" translatable="false">TXT</string>
    <string name="files_badge_office" translatable="false">DOC</string>
    <string name="files_badge_other" translatable="false">FILE</string>
    <!-- Spoken action labels for two full-surface clickables that had no named descendant, so a
         screen reader announced each as an unlabelled button (G15). They name the action, not the
         surface. -->
    <string name="files_viewer_toggle_chrome_a11y">Show or hide the viewer\'s controls</string>
    <string name="files_viewer_dismiss_details_a11y">Close the details sheet</string>
