    <!-- The format name the preview appends after the item count ("12 items found · CSV"). Three
         source cards (Google / Chrome, Apple Passwords, Other / CSV) all parse as CSV, and the
         preview used to print the *card* label for all three — so a Chrome import announced itself
         as "Other / CSV" (device, 2026-09-14). A format is not a source; it gets its own name. -->
    <string name="import_format_label_csv" translatable="false">CSV</string>

    <!-- ==================== ImportSource.kt — export steps, per source ==================== -->
    <string name="import_source_chrome_step_1">Open Chrome on this device and tap ⋮ → Settings.</string>
    <string name="import_source_chrome_step_2">Tap Password Manager, then the ⚙ Settings icon inside it.</string>
    <string name="import_source_chrome_step_3">Tap Export passwords and confirm with your screen lock.</string>
    <string name="import_source_chrome_step_4">Choose a location you can find again — Downloads is fine.</string>
    <string name="import_source_chrome_caveat_1">Chrome exports logins only. Saved cards and addresses are not included — you\'ll need to add those by hand, or import them from another manager.</string>
    <string name="import_source_chrome_caveat_2">The exported file is plain, unencrypted text. Delete it as soon as the import is done; the last step of this wizard can do that for you.</string>

    <string name="import_source_apple_step_1">On a Mac: open the Passwords app, then File → Export All Passwords.</string>
    <string name="import_source_apple_step_2">On iPhone/iPad: Settings → Passwords → ⋯ → Export Passwords (iOS 18 or later).</string>
    <string name="import_source_apple_step_3">Save the CSV, then transfer it to this device however you normally move files.</string>
    <!-- Corrected 2026-09-20 (1B-F2): this said Apple exports no notes. It exports a per-login
         Notes column, which LocalKeep imports in full; what it has no export for is a standalone
         secure note or a card. -->
    <string name="import_source_apple_caveat_1">Apple exports logins, their 2FA codes and each login\'s own note. Cards and standalone notes have no export.</string>
    <string name="import_source_apple_caveat_2">Passkeys can\'t be exported by any current version — they stay on your Apple devices.</string>

    <string name="import_source_bitwarden_step_1">Open Bitwarden\'s web vault at vault.bitwarden.com (the mobile app can\'t export).</string>
    <string name="import_source_bitwarden_step_2">Go to Tools → Export vault.</string>
    <string name="import_source_bitwarden_step_3">Choose the .json format. An encrypted one works too, as long as you pick \"Password protected\" rather than \"Account restricted\".</string>
    <string name="import_source_bitwarden_step_4">Confirm with your master password and save the file.</string>
    <string name="import_source_bitwarden_caveat_1">A password-protected .json export opens here — LocalKeep asks for that password. An account-restricted export can only be opened by Bitwarden itself.</string>
    <string name="import_source_bitwarden_caveat_2">File attachments are not included in any Bitwarden export.</string>
    <string name="import_source_bitwarden_caveat_3">Collections come across as tags, because an item can be in more than one. Your own folders stay folders.</string>
    <string name="import_source_bitwarden_caveat_4">Passkeys are in the export, but LocalKeep doesn\'t import them — they stay in Bitwarden. Keep your Bitwarden account if you still need them.</string>

    <string name="import_source_onepassword_step_1">Open the 1Password desktop app (mobile can\'t export).</string>
    <string name="import_source_onepassword_step_2">Choose File → Export → the account you want.</string>
    <string name="import_source_onepassword_step_3">Pick the 1Password Unencrypted Export (.1pux) format.</string>
    <string name="import_source_onepassword_step_4">Enter your account password and save the file.</string>
    <string name="import_source_onepassword_caveat_1">A .1pux file is a zip of plain JSON. Treat it like a printed copy of your vault until it\'s wiped.</string>
    <string name="import_source_onepassword_caveat_2">A file saved as its own 1Password Document comes across. A file attached to a login, card or identity does not — keep your 1Password account, or save those somewhere else first.</string>

    <string name="import_source_keepass_step_1">Find your database file — it ends in .kdbx.</string>
    <string name="import_source_keepass_step_2">On a phone, copy it into Files or Drive so you can pick it here.</string>
    <string name="import_source_keepass_step_3">Choose it below and enter that database\'s master password.</string>
    <string name="import_source_keepass_caveat_1">The database stays encrypted the whole time — LocalKeep opens it in memory only.</string>
    <!-- Corrected 2026-09-20 (1A-F1): this said key files were not supported. They are, and have
         been — .keyx, a 64-hex .key and a key-file-only database with a blank password all import
         (verified on device). Hardware keys are the part that is genuinely not supported. -->
    <string name="import_source_keepass_caveat_2">Key files work — after the password step you can add one. Hardware keys like a YubiKey aren\'t supported.</string>
    <!-- 2FA seeds import too: a login that had one now shows its own rolling code on the login
         itself, so this tells the user to verify that before uninstalling their authenticator. -->
    <string name="import_source_keepass_caveat_3">2FA seeds come across too: a login that had one shows its code on the login itself. Check one works before you uninstall your authenticator.</string>
    <!-- Added 2026-08-30. Files attached to KDBX entries are not carried over, and until now
         nothing told the user — while the Done step offers to delete the source database. -->
    <string name="import_source_keepass_caveat_4">Files attached to entries don\'t come across. Keep your database, or save those files somewhere else first.</string>

    <string name="import_source_aegis_step_1">Open Aegis and go to Settings → Import &amp; Export.</string>
    <string name="import_source_aegis_step_2">Tap Export, and choose the plain JSON format.</string>
    <string name="import_source_aegis_step_3">Confirm the warning and save the file.</string>
    <string name="import_source_aegis_caveat_1">Choose the unencrypted JSON export; the encrypted one uses Aegis\'s own format.</string>
    <string name="import_source_aegis_caveat_2">This imports your 2FA codes. Keep Aegis installed until you\'ve confirmed a code works in LocalKeep — locking yourself out of 2FA is much worse than a duplicate.</string>

    <!-- Keeper, Enpass, Proton Pass and Dashlane, added 2026-09-17 with their importers.
         The brand names are import_source_label_*, already translatable="false". Menu paths
         inside the other apps are left in English on purpose: they are what the user will see
         on that app's own screen, and translating them would send them looking for a label
         that is not there. Every caveat states a limitation that was measured against a real
         export, not a general disclaimer. -->
    <string name="import_source_keeper_step_1">Open the Keeper Web Vault in a browser — the phone app can\'t export.</string>
    <string name="import_source_keeper_step_2">Go to Settings, then Export.</string>
    <string name="import_source_keeper_step_3">Choose JSON. Keeper\'s CSV works too, but the JSON export is the one that carries your folders, record types and custom fields.</string>
    <string name="import_source_keeper_step_4">Save the file, then bring it to this phone.</string>
    <string name="import_source_keeper_caveat_1">SSH keys aren\'t imported — LocalKeep has no item type for one. They\'re listed by name on the preview so you know what stayed behind.</string>
    <string name="import_source_keeper_caveat_2">A record filed in more than one Keeper folder lands in the first of them; the others are kept on the item as a field named folders.</string>
    <string name="import_source_keeper_caveat_3">Keeper\'s CSV export has no header row, so it\'s read by column position. If your CSV was edited or re-saved by a spreadsheet, export JSON instead.</string>
    <string name="import_source_keeper_caveat_4">Record attachments and file or photo records aren\'t carried — only the record\'s own fields.</string>
    <string name="import_source_enpass_step_1">Open Enpass.</string>
    <string name="import_source_enpass_step_2">Go to Settings, then Advanced, then Export.</string>
    <string name="import_source_enpass_step_3">Choose JSON. Enpass\'s CSV works too, but only the JSON export carries your folders and your item categories.</string>
    <string name="import_source_enpass_step_4">Confirm with your Enpass master password.</string>
    <string name="import_source_enpass_caveat_1">Items in Enpass\'s trash aren\'t imported. They\'re listed by name on the preview.</string>
    <string name="import_source_enpass_caveat_2">An Enpass CSV export of secure notes only isn\'t recognised — its rows carry nothing that identifies them as Enpass. Export JSON instead.</string>
    <string name="import_source_enpass_caveat_3">Attachments aren\'t carried — only the item\'s own fields.</string>
    <string name="import_source_protonpass_step_1">Open Proton Pass, or the web vault.</string>
    <string name="import_source_protonpass_step_2">Go to Settings, then Export.</string>
    <string name="import_source_protonpass_step_3">Choose JSON, not \"encrypted\".</string>
    <string name="import_source_protonpass_step_4">Proton Pass saves a .zip. Unzip it and pick the data.json inside.</string>
    <string name="import_source_protonpass_caveat_1">Proton Pass exports a zip. Unzip it first and choose the .json file inside — this app reads the JSON, not the archive.</string>
    <string name="import_source_protonpass_caveat_2">Items in Proton Pass\'s trash aren\'t imported, and SSH keys aren\'t either. Both are listed by name on the preview.</string>
    <string name="import_source_protonpass_caveat_3">Each Proton Pass vault becomes a folder.</string>
    <string name="import_source_protonpass_caveat_4">Passkeys aren\'t carried.</string>
    <string name="import_source_dashlane_step_1">Open Dashlane on a computer — the phone app can\'t export.</string>
    <string name="import_source_dashlane_step_2">Go to My Account, then Settings, then Export.</string>
    <string name="import_source_dashlane_step_3">Choose CSV.</string>
    <string name="import_source_dashlane_step_4">Dashlane saves a zip of several files. Bring them to this phone and import them one at a time.</string>
    <string name="import_source_dashlane_caveat_1">Dashlane exports one file per kind of record: credentials.csv for your logins, payments.csv for cards and bank accounts, id.csv for documents, personal-info.csv and securenotes.csv. Import each one separately, or you\'ll only get part of your data.</string>
    <string name="import_source_dashlane_caveat_2">A Dashlane bank account is saved as a note, with its account and routing numbers masked — it isn\'t a payment card.</string>
    <string name="import_source_dashlane_caveat_3">personal-info.csv has one row per detail, not one per person, so each row becomes its own entry.</string>
    <string name="import_source_csv_step_1">Export your data from the other manager as CSV.</string>
    <string name="import_source_csv_step_2">Most managers put this under Settings, Tools, or Export.</string>
    <string name="import_source_csv_step_3">LocalKeep works out which column is which from the header row.</string>
    <string name="import_source_csv_caveat_1">A CSV needs a header row naming the columns. Without one there\'s no way to tell a username from a password.</string>
</resources>
