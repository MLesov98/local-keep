    <!-- ==================== ImportSource.kt — source names (never translated: other products' names) ==================== -->
    <string name="import_source_label_chrome" translatable="false">Google / Chrome</string>
    <string name="import_source_label_apple" translatable="false">Apple Passwords</string>
    <string name="import_source_label_bitwarden" translatable="false">Bitwarden</string>
    <string name="import_source_label_onepassword" translatable="false">1Password</string>
    <string name="import_source_label_keepass" translatable="false">KeePass</string>
