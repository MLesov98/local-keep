<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!-- ==================== ImportWizardScreen.kt ==================== -->
    <string name="import_screen_title">Import</string>
    <string name="import_nav_close">Close</string>
    <string name="import_nav_back">Back</string>

    <!-- "Step X of 4" subtitle under the header — the wizard has no progress rail, so this
         carries it. PASSWORD and INSTRUCTIONS deliberately share "Step 2 of 4". -->
    <string name="import_step_progress_pick_source">Step 1 of 4 · choose a source</string>
    <string name="import_step_progress_instructions">Step 2 of 4 · export the file</string>
    <!-- The KeePass wording. A Bitwarden export is an export, not a database, and got this one
         too until 2026-09-20 (1A-F9) — see import_step_progress_export_password. -->
    <string name="import_step_progress_password">Step 2 of 4 · unlock the database</string>
    <string name="import_step_progress_export_password">Step 2 of 4 · unlock the export</string>
    <string name="import_step_progress_preview">Step 3 of 4 · review what lands</string>
    <string name="import_step_progress_done">Step 4 of 4 · clean up</string>

    <!-- Shown on the PREVIEW step while the import is being written to the vault. -->
    <string name="import_working_saving">Adding items to your vault…</string>
    <!-- Shown on every other step while the picked file is being read or parsed. -->
    <string name="import_working_reading">Reading the file…</string>

    <!-- ==================== Source picker ==================== -->
    <string name="import_source_title">Where are your passwords now?</string>
    <string name="import_source_body">Android doesn\'t let one app read another\'s saved passwords — the same protection that keeps LocalKeep\'s vault private. So this can\'t be fully automatic: you\'ll export a file, and LocalKeep takes it from there.</string>
    <!-- Accessibility description of a source tile that can't be used yet. %1$s is the source name (e.g. "Apple Passwords"). -->
    <string name="import_source_tile_blocked_description">%1$s, not available yet</string>
    <!-- Caption on a source tile that can't be used yet. -->
    <string name="import_source_tile_unavailable">Not available yet</string>

    <!-- ==================== Instructions step ==================== -->
    <!-- Section label above the export steps. %1$s is the source name. -->
    <string name="import_instructions_export_from">Export from %1$s</string>
    <!-- Button that launches the other app, when it's installed. %1$s is the source name. -->
    <string name="import_instructions_open_source_app">Open %1$s</string>
    <string name="import_instructions_open_export_page">Open the export page</string>
    <string name="import_instructions_copy_steps">Copy these steps</string>
    <string name="import_instructions_steps_copied">Steps copied to clipboard</string>
    <!-- Fallback confirmation when "Open the export page" can't launch a browser; the URL is
         copied instead so the user can still get there. -->
    <string name="import_instructions_export_page_copied">Couldn\'t open that automatically. Copied the link to your clipboard instead.</string>
    <string name="import_instructions_worth_knowing">Worth knowing</string>
    <string name="import_instructions_choose_file">Choose the exported file</string>

    <!-- The amber "you have to do this part yourself" panel. -->
    <string name="import_why_manual_title_computer">This export needs a computer</string>
    <!-- %1$s is the source name (e.g. "1Password"). -->
    <string name="import_why_manual_body_computer">%1$s can only export from its desktop app, so this step can\'t happen on your phone at all. Do it on a computer, get the file onto this device, then come back — everything after that is automatic.</string>

    <!-- Accessibility description of one export step, merged into a single node.
         %1$d = step number, %2$d = total steps, %3$s = the step's instruction. -->
    <string name="import_step_row_description">Step %1$d of %2$d. %3$s</string>
    <!-- Visible step number badge, e.g. "STEP 2". -->
    <string name="import_step_row_number">STEP %1$d</string>

    <!-- ==================== Password step ==================== -->
    <string name="import_password_default_filename">Selected database</string>
    <!-- The same three controls, for a password-protected EXPORT rather than a KeePass
         database. Bitwarden writes the same JSON either way and only the file says which it is, so
         which set is shown is decided per file, not per source tile. A separate key rather than a
         %1$s noun in one string: "database" and "export" decline differently in de/fr/es/pt, and a
         placeholder would force every locale to a shape that fits neither. -->
    <string name="import_password_default_filename_export">Selected export</string>
    <!-- SECURITY-COPY: tier C -->
    <string name="import_password_body">This database is encrypted. Its password is used once, in memory, to read it — it is never stored and never becomes your LocalKeep master password.</string>
    <!-- The same claim as import_password_body above, about a password-protected export rather
         than a database. Gauntlet-translated 2026-09-17 (sibling text, noun and agreement only). -->
    <!-- SECURITY-COPY: tier C -->
    <string name="import_password_body_export">This export is encrypted. Its password is used once, in memory, to read it — it is never stored and never becomes your LocalKeep master password.</string>
    <string name="import_password_field_label">Database password</string>
    <string name="import_password_field_label_export">Export password</string>
    <!-- Masked placeholder dots, not a word — same treatment as the generator's separator hint. -->
    <!-- Empty on purpose. This was twelve bullet characters until 2026-09-09, so an EMPTY
         password field rendered more mask characters than a real four-character password —
         you could not tell "nothing typed" from "something typed", on the unlock screen
         most of all. The field keeps its own label above it and an explicit a11y label at
         every call site, so nothing is lost by showing an empty field as empty.
         translatable="false" is kept: there is no text left to translate. -->
    <string name="import_password_field_placeholder" translatable="false"></string>
    <string name="import_password_submit">Open database</string>
    <string name="import_password_submit_export">Open export</string>
    <!-- Key file. KeePass lets a database be protected by a password, a key file, or both, and
         nothing in the container says which — so the second file has to be asked for. -->
    <string name="import_password_key_file_add">Add key file</string>
    <string name="import_password_key_file_chosen">Key file: %1$s</string>
    <!-- Fallback when the file provider gives no display name for the picked key file. -->
    <string name="import_password_key_file_unnamed">Key file</string>

    <!-- ==================== Preview step ==================== -->
    <plurals name="import_preview_items_found">
        <item quantity="one">%1$d item found</item>
        <item quantity="other">%1$d items found</item>
    </plurals>
    <!-- Appends the detected format after the item count, e.g. "42 items found · CSV". %1$s is
         the already-pluralised item count, %2$s is the format name (an importer identifier). -->
    <string name="import_preview_items_found_with_format">%1$s · %2$s</string>
    <plurals name="import_preview_duplicate_count">
        <item quantity="one">%1$d already looks like an entry you have.</item>
        <item quantity="other">%1$d already look like entries you have.</item>
    </plurals>
    <!-- Rows that repeat an earlier row of the same export rather than matching anything in the
         vault. Counted and stated separately from import_preview_duplicate_count above, which is a
         claim about the vault and was being made about same-file repeats too. -->
    <plurals name="import_preview_file_duplicate_count">
        <item quantity="one">%1$d is repeated inside the file itself.</item>
        <item quantity="other">%1$d are repeated inside the file itself.</item>
    </plurals>

    <!-- The two merge-mode chips. -->
    <string name="import_mode_merge">Merge duplicates</string>
    <string name="import_mode_add_all">Add everything</string>
    <string name="import_mode_merge_description">Matching entries are combined, keeping whichever copy is newer.</string>
    <string name="import_mode_add_all_description">Everything selected is added, even where you already have it. You\'ll end up with two copies of those.</string>

    <string name="import_preview_select_all">Select all</string>
    <string name="import_preview_select_none">None</string>
    <string name="import_preview_skip_duplicates">Skip duplicates</string>

    <plurals name="import_preview_import_button">
        <item quantity="one">Import %1$d item</item>
        <item quantity="other">Import %1$d items</item>
    </plurals>
    <string name="import_preview_nothing_selected">Nothing selected</string>

    <!-- What the parser couldn't carry, shown on the preview and again before clean-up.
         %1$d = skipped count, %2$s = the reasons list (built in Kotlin from importer-reported
         reasons, not translated here). -->
    <plurals name="import_skipped_summary">
        <item quantity="one">%1$d entry in that file could not be imported and is not in this list: %2$s. Keep your export until you have copied those across by hand.</item>
        <item quantity="other">%1$d entries in that file could not be imported and are not in this list: %2$s. Keep your export until you have copied those across by hand.</item>
    </plurals>

    <!-- Columns the file carried that LocalKeep has no field of its own for, kept as custom fields
         instead of being dropped. %1$d = how many, %2$s = the column names, read out of the user's
         own file and therefore not translated. Shown on the preview and again before clean-up. -->
    <plurals name="import_carried_columns_summary">
        <item quantity="one">%1$d column has no matching field in LocalKeep, so it was kept as a custom field: %2$s.</item>
        <item quantity="other">%1$d columns have no matching field in LocalKeep, so they were kept as custom fields: %2$s.</item>
    </plurals>

    <!-- A two-factor seed the app cannot compute a code from, kept as a hidden field on the item
         instead. %1$d = how many. Shown on the preview and again before clean-up. -->
    <plurals name="import_unusable_totp_summary">
        <item quantity="one">%1$d two-factor code can\'t be generated here — its seed was kept on the item as a hidden field so you can move it yourself.</item>
        <item quantity="other">%1$d two-factor codes can\'t be generated here — their seeds were kept on the items as hidden fields so you can move them yourself.</item>
    </plurals>

    <!-- A KeePass entry that borrows a field from another entry ({REF:U@I:...}), where the entry it
         points at could not be found, so the reference stayed as text. %1$d = how many items.
         Shown on the preview and again before clean-up. This string carries no tier. -->
    <plurals name="import_unresolved_reference_summary">
        <item quantity="one">%1$d item borrows a field from another KeePass entry that couldn\'t be found, so the reference was kept as text instead of a value.</item>
        <item quantity="other">%1$d items borrow a field from another KeePass entry that couldn\'t be found, so the references were kept as text instead of values.</item>
    </plurals>

    <!-- A login whose only credential was a passkey. The item crosses over with its name and
         address; the passkey itself cannot be imported. %1$d = how many. Shown on the preview and
         again before clean-up. This string carries no tier. -->
    <plurals name="import_passkey_only_summary">
        <item quantity="one">%1$d login carried only a passkey, which can\'t be imported — keep signing in with it where it is.</item>
        <item quantity="other">%1$d logins carried only a passkey, which can\'t be imported — keep signing in with them where they are.</item>
    </plurals>

    <!-- Accessibility state words appended to a preview row's name. -->
    <string name="import_preview_row_selected">selected</string>
    <string name="import_preview_row_not_selected">not selected</string>
    <!-- Merges a preview row into one accessibility node: %1$s = title, %2$s = selection word,
         %3$s = the disposition sentence (see import_disposition_*). -->
    <string name="import_preview_row_description">%1$s, %2$s. %3$s</string>

    <!-- Second line of a preview row when the item updates one already in the vault.
         %1$s = the item's own subtitle, %2$s = the title of the existing entry it collides with. -->
    <string name="import_disposition_updates_existing">%1$s · newer than your \"%2$s\"</string>
    <!-- Second line of a preview row when the vault already has a newer copy. %1$s = subtitle. -->
    <string name="import_disposition_already_current">%1$s · you already have a newer copy</string>
    <!-- Second line of a preview row that repeats an EARLIER ROW OF THE SAME EXPORT rather than
         anything in the vault. Split from import_disposition_* above for the reason
         import_preview_file_duplicate_count was split from import_preview_duplicate_count: "you
         already have" is a claim about the vault, and it was being made about same-file repeats,
         which are rows the user has never seen before. %1$s = subtitle. -->
    <string name="import_disposition_updates_earlier_row">%1$s · newer than an earlier row in this file</string>
    <string name="import_disposition_already_in_file">%1$s · repeated earlier in this file</string>
    <!-- Second line of a preview row that matches a vault entry when the export carries no
         per-entry dates (CSV, Aegis). Distinct from import_disposition_already_current because
         "newer" is a comparison, and there is nothing in the file to compare against — what the
         user needs to know is which copy survives. %1$s = subtitle. -->
    <string name="import_disposition_undated_keeps_yours">%1$s · no dates in this file, so your entry is kept</string>

    <!-- ==================== Done step ==================== -->
    <!-- Announced live: the wizard auto-advances into this step with no user action, so a screen
         reader needs this read without the user going looking for it. -->
    <plurals name="import_done_updated_summary">
        <item quantity="one">Updated %1$d item</item>
        <item quantity="other">Updated %1$d items</item>
    </plurals>
    <plurals name="import_done_imported_summary">
        <item quantity="one">Imported %1$d item</item>
        <item quantity="other">Imported %1$d items</item>
    </plurals>
    <!-- %1$s = already-pluralised "N items imported", %2$s = already-pluralised "N merged...". -->
    <string name="import_done_notice_combined">%1$s; %2$s</string>
    <plurals name="import_done_notice_imported">
        <item quantity="one">%1$d item imported</item>
        <item quantity="other">%1$d items imported</item>
    </plurals>
    <plurals name="import_done_notice_merged">
        <item quantity="one">%1$d merged into an entry you already had.</item>
        <item quantity="other">%1$d merged into entries you already had.</item>
    </plurals>
    <!-- A selected row that repeated an EARLIER ROW OF THE SAME FILE and was folded into it. Its own
         sentence, shown beside import_done_notice_merged and never joined to it: "merged into
         entries you already had" is a claim about the vault, and these rows matched nothing there. -->
    <plurals name="import_done_notice_repeated">
        <item quantity="one">%1$d item repeated an earlier item in the file and was merged into it.</item>
        <item quantity="other">%1$d items repeated earlier items in the file and were merged into them.</item>
    </plurals>

    <string name="import_done_cleanup_title">Clean up</string>
    <string name="import_done_file_deleted">The export file has been deleted.</string>
    <!-- A file that is still encrypted on disk: a .kdbx, or a Bitwarden export written as
         "Password protected". This must never say "plain, unencrypted copy" the way the
         generic export warning below does. It names a file rather than a database because
         the KeePass source is no longer the only one that reaches it; the key said
         _keepass until 2026-09-17, when it stopped being true. -->
    <!-- SECURITY-COPY: tier A -->
    <string name="import_done_delete_warning_encrypted">That file is still sitting in your storage, protected only by its own password. If you\'re done with it, delete it now.</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="import_done_delete_warning_plain">That export file is a plain, unencrypted copy of your passwords sitting in your storage. Delete it now.</string>
    <!-- States a security property (ordinary delete, not a secure erase) —
         must never be softened into implying remnants can't survive. -->
    <!-- SECURITY-COPY: tier G -->
    <string name="import_done_delete_footnote">This is a normal delete, not a secure erase — Android doesn\'t give apps the low-level access that would need. For anything highly sensitive, treat the export as having existed.</string>

    <string name="import_done_delete_button_working">Deleting…</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="import_done_delete_button_keepass">Delete the database file</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="import_done_delete_button_generic">Delete the export file</string>

    <!-- Confirmation dialog gating the delete button above (spec §6, F8 hardening fix). -->
    <!-- SECURITY-COPY: tier A -->
    <string name="import_preview_discard_confirm_title">Discard this preview?</string>
    <string name="import_preview_discard_confirm_body">Going back drops the parsed entries and the choices you made about them. Nothing has been imported yet, and your file is untouched — you would start again from reading it.</string>
    <string name="import_preview_discard_confirm_button">Discard</string>
    <string name="import_done_delete_confirm_title">Delete this file permanently?</string>
    <!-- SECURITY-COPY: tier A -->
    <string name="import_done_delete_confirm_body">This removes it from your device for good. There is no undo.</string>

    <string name="import_done_keep_app_footnote">Keep the other app installed until you\'ve checked a few entries — especially any 2FA codes. Nothing has been removed from it.</string>
    <string name="import_done_finish_button">Done</string>

    <!-- ==================== ImportWizardViewModel.kt — error messages ==================== -->
    <!-- The ViewModel never holds display strings; it exposes these ids via ImportError and the
         composable resolves them with stringResource, per GeneratorViewModel.error. -->
    <string name="import_error_read_failed">Couldn\'t read that file.</string>
    <string name="import_error_unrecognised_format">That file isn\'t in a format LocalKeep recognizes. If it came from a password manager, export it again and pick a plain, unencrypted format.</string>
    <!-- The picked file is LocalKeep's own .vault backup, recognised by its container header.
         Answered instead of import_error_unrecognised_format, which told a user moving to a new
         phone that their own backup was in a format LocalKeep does not recognise. "Backup & export"
         and "Import a .vault file" are the screen title and section label it points at
         (backup_screen_title, backup_import_section) and must read the same. -->
    <string name="import_error_localkeep_backup">That file is a LocalKeep backup, not an export from another app. Restore it from Backup &amp; export, under Import a .vault file.</string>
    <!-- Hand-off button under import_error_localkeep_backup. Opens Backup & export. -->
    <string name="import_open_backup_button">Open Backup &amp; export</string>
    <!-- The picked file is 0 bytes. Named apart from import_error_empty_file, which is a file that
         parsed and held no items: this one never held anything to parse. -->
    <string name="import_error_source_file_empty">That file is empty — 0 bytes. The export didn\'t finish writing it, so export again and check the file\'s size before picking it.</string>
    <!-- The file reads as a delimited text file, but its header row binds no password column. -->
    <string name="import_error_csv_header_unrecognised">LocalKeep works out which column is which from the header row, and this file\'s header has no column it recognizes as a password. Rename the password column to "Password", or export in a format LocalKeep lists.</string>
    <string name="import_error_vault_read_failed">Couldn\'t read your current vault, so this import can\'t tell which of these you already have. Your vault may have locked while the file was being read — open it again and retry.</string>
    <string name="import_error_empty_file">That file parsed correctly but contained no items.</string>
    <string name="import_error_nothing_selected">Nothing is selected to import.</string>
    <string name="import_error_save_failed">Couldn\'t save the imported items.</string>
    <!-- Two apply failures a retry cannot fix (2026-10-02). Adapted from itemedit_error_vault_too_large
         and itemedit_error_out_of_space, without the first one's claim about the stored vault.
         The too-large one also covers a full layout bucket. Carries no tier. -->
    <string name="import_error_save_vault_too_large">This vault has grown too large to save the imported items on this device. Import fewer items at a time, or delete or export some items — large files and photos first.</string>
    <string name="import_error_save_out_of_space">This device is out of storage space, so the imported items could not be saved. Free up space, then try again.</string>
    <string name="import_error_delete_failed">Couldn\'t delete it from here — delete it yourself in Files, then empty the trash.</string>
    <!-- The Instructions step's "Open the source app" button, when no app resolves the intent. -->
    <string name="import_error_open_app_failed">No app on this device can open that.</string>

    <!-- ==================== core/import — ImportFailureReason (Task 10 / F2, F22) ====================
         core/import is a pure-Kotlin/JVM leaf module and cannot hold string resources or call
         stringResource, so it returns a typed ImportFailureReason instead of English text.
         ImportWizardScreen.resolve() maps each case to one of these. %1$s where present is a
         source's brand name (import_source_label_*), already translatable="false" — see
         the do-not-translate list's "Import source names" section. -->
    <string name="core_import_error_malformed_export">This doesn\'t look like a valid %1$s export.</string>
    <string name="core_import_error_container_encrypted">This %1$s export is password-protected. Turn off encryption when you export it, then try again.</string>
    <!-- Bitwarden's other encrypted shape, and the reason it cannot share the string above:
         an "Account restricted" export is sealed with the account's own key, which never
         travels in the file, so "turn off encryption" is not the only remedy and is the
         worse one. Re-exporting as "Password protected" opens here (the wizard asks for
         that password) and never writes the passwords to storage in the clear. -->
    <string name="core_import_error_account_encrypted">This export is protected with your %1$s account key, which LocalKeep cannot use. Export it again as unencrypted or as password-protected.</string>
    <!-- Only ever shown when a key file WAS supplied — with none, the message above keeps both
         possibilities open. It used to name the password alone, so a correct password with the
         wrong key file pointed the user at the one thing that was right (1A-F6, 2026-09-20). KDBX
         verifies the whole composite key in one step and cannot say which half failed. -->
    <string name="core_import_error_wrong_password">Wrong password — or that isn\'t this database\'s key file. KeePass checks both together, so it can\'t say which.</string>
    <!-- A password-protected export whose export password was wrong. Separate from the KeePass
         message above (which names a database) and from container_encrypted (which tells the user
         to export again — advice for a file no password can open, and wrong for this one). -->
    <string name="core_import_error_wrong_export_password">Wrong password for this %1$s export.</string>
    <!-- KDBX verifies the whole composite key at once, so a database that wants a key file is
         refused exactly as a mistyped password is. With no key file supplied, the message has to
         keep both possibilities open rather than assert the password is wrong. -->
    <string name="core_import_error_wrong_password_or_key_file">Wrong password — or this database also needs its key file.</string>
    <string name="core_import_error_unreadable_key_file">That key file couldn\'t be read. Check you picked the right file.</string>
    <string name="core_import_error_not_kdbx_file">This file isn\'t a KeePass database.</string>
    <!-- A KeePass 1.x .kdb. It shares KDBX's first four magic bytes, so it is recognised as a
         KeePass file and then refused — and "this file isn't a KeePass database" was the wrong
         sentence for a file that is one, just the previous format. Nothing here can read it; what
         works is re-saving it from KeePass, so the message says that. -->
    <string name="core_import_error_legacy_keepass1_file">This is a KeePass 1 database (.kdb). Open it in KeePass, save it as .kdbx, then import that file.</string>
    <string name="core_import_error_damaged_kdbx_file">The KeePass database couldn\'t be read — the file looks damaged.</string>
    <string name="core_import_error_kdbx_support_broken">KDBX support is broken in this build of LocalKeep — this isn\'t a problem with your password or your file. Please report it.</string>
    <!-- The KDBX file's own KDF asks for more memory than the device allows an app, so the
         derivation died before any credential check could run. Kept apart from the damaged-file and
         wrong-password messages because it used to be reported as both, for the same file (G13). The
         remedy is in the app the user is leaving, so it has to be named.
         It used to close with "nothing is wrong with your file or your password". That was
         an over-claim: the derivation dies before any credential check runs, so the app has
         not checked the password and cannot say it is right. Cut in all five languages
         rather than reworded, so no locale keeps the claim (V8, 2026-09-12). -->
    <string name="core_import_error_kdbx_kdf_too_large">This database\'s encryption needs more memory than this device allows an app, so it can\'t be opened here. In KeePass, lower the key-derivation memory under Database security and export again.</string>
    <!-- A valid export this device cannot hold in memory. Deliberately separate from the
         malformed-export message, which used to swallow it: an OutOfMemoryError is not a claim
         anyone can make about the file. Names no remedy, because there is none to name — a
         Bitwarden or Aegis export is all-or-nothing ("Go to Tools -> Export vault"), so telling
         the user to export less would be an instruction they cannot follow (V14). -->
    <string name="core_import_error_export_needs_more_memory">Reading this %1$s export needs more memory than this device allows an app, so it can\'t be read here.</string>
    <string name="core_import_error_onepux_missing_export_data">This .1pux file doesn\'t contain a 1Password export.</string>
    <!-- %1$d is the fixed decompression cap (MAX_EXPORT_DATA_BYTES in OnePuxImporter), not a value
         read from the untrusted file, so it is safe to show as-is. -->
    <string name="core_import_error_export_too_large">This export is larger than the %1$d MB import limit.</string>
    <string name="core_import_error_unexpected">Couldn\'t read this file. It may be corrupted or in a format LocalKeep doesn\'t support.</string>

    <!-- ==================== core/import — SkipReason (Task 10) ====================
         Why one entry inside an otherwise-readable export was left out — grouped and counted in the
         preview ("Bank Account (2); HOTP code (1)"). Same "module can't hold resources" reasoning
         as ImportFailureReason above. -->
    <!-- "%1$s (%2$d)" — one skip-reason group in the preview's list, e.g. "Bank Account (2)". -->
    <string name="core_import_skip_reason_count">%1$s (%2$d)</string>
    <string name="core_import_skip_incomplete_entry">Incomplete entry in the export</string>
    <string name="core_import_skip_ssh_key">SSH key — LocalKeep has no item type for one</string>
    <!-- %1$d is Bitwarden's own integer item-type code, shown as a debugging aid. -->
    <string name="core_import_skip_unsupported_bitwarden_type">Unsupported Bitwarden type (%1$d)</string>
    <!-- %1$s is Aegis's own entry-type string, upper-cased — a format identifier, not a word, so it
         is not translated on its own. In practice this is HOTP: counter-based codes have nowhere to
         live in `Totp`, which has no counter field. STEAM used to reach here too and no longer does
         (2026-09-11) — the app generates Steam Guard codes and the 2FA editor has a toggle for them,
         so this sentence was telling users the app lacked a feature it ships. -->
    <string name="core_import_skip_unsupported_aegis_type">%1$s code — LocalKeep only carries TOTP</string>
    <!-- %1$s algorithm name, %2$d digit count, %3$d period in seconds — all technical parameters. -->
    <string name="core_import_skip_unsupported_totp_settings">Unsupported TOTP settings (%1$s, %2$d digits, %3$ds)</string>
    <string name="core_import_skip_onepassword_archived">Archived item</string>
    <!-- Grouping label for an entry that was already in the source app's deleted items — today
         only KeePass's Recycle Bin. Never says "archived": the user deleted it. A headed noun
         phrase like every other reason in this family, because a bare participle carries gender in
         fr/es/pt with nothing to agree with. The glossary's `trash` row supplies the bin's name in
         each language (corbeille / Papierkorb / papelera / lixeira) rather than a verb: the entry
         is recoverable where it sits, not purged. -->
    <string name="core_import_skip_source_recycle_bin">Item in the other app\'s trash</string>
    <string name="core_import_skip_onepassword_category_unsupported">Unsupported 1Password type</string>
    <string name="core_import_skip_no_login_fields">No address, username or password</string>

