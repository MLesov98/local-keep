    <!-- Security · Duress vault. Entire feature is SECURITY-COPY tier D. -->
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_title">Duress vault</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_summary_pro">A second password that opens a decoy</string>
    <!-- "Pro" is the app's paid-tier name and stays untranslated
         in every locale. -->
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_summary_free">Pro · a second password that opens a decoy</string>
    <!-- The limit is stated where the decision is made, not only in the
         threat model. This read "Your real vault is untouched and gives no sign it exists" with a
         single caveat about biometrics, which is an unqualified protection claim on the one feature
         whose whole risk is a user believing it protects more than it does. THREAT-MODEL.md lists
         coercion under "What LocalKeep does not defend against" — "the duress vault exists for
         this, but it is a mitigation, not a defence" — under a heading that opens "Stated plainly
         so no UI copy ever implies otherwise". Found by the F14 UX persona, 2026-08-30. -->
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_body_explain">Entering this password at the unlock screen opens a separate decoy vault, pre-filled with ordinary-looking logins you can edit. Your real vault is untouched, and nothing in the decoy points to it. This buys you a plausible answer under pressure; it is not a defence. Someone who already knows this app has the feature can simply demand a second password, and biometric unlock and the Recovery Kit both open the real vault whatever you say.</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_body_replace_warning">Running this again replaces any duress password already set, and rebuilds the decoy vault from scratch — anything you edited inside it is discarded.</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_password_label">Duress password</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_confirm_label">Confirm duress password</string>
    <!-- Also reused as the confirm label of the "replace" dialog below. -->
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_setup_button">Set up duress vault</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_remove_button">Remove the duress vault</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_gate_body">Enter your vault password to confirm this change.</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_gate_label">Vault password</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_remove_dialog_title">Remove the duress vault?</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_remove_dialog_body">The duress password stops opening anything and the decoy is overwritten. If duress was never set up, this does nothing. Your real vault is not touched.</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_remove_confirm">Remove</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_replace_dialog_title">Replace the duress vault?</string>
    <!-- SECURITY-COPY: tier D -->
    <string name="settings_duress_replace_dialog_body">This sets the duress password and builds a fresh decoy vault. If duress is already set up, the old password stops working and any edits you made to the decoy are lost. Your real vault is not touched.</string>
    <!-- Passed to ProUpsell as the reason Pro is required. -->
