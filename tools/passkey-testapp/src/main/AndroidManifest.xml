<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Every request the WebView makes is answered from this app's own assets by
        WebLoginActivity's interceptor, so nothing here actually reaches a network. The permission
        is declared anyway because a sub-resource that ever escapes the interceptor would otherwise
        fail as an unexplained blank page on a device the agent driving it cannot debug.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="LocalKeep Passkey Test"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".WebLoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
